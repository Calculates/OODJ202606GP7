#!/bin/sh
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$APP_DIR/../../../" && pwd)
cd "$PROJECT_DIR"

if ! command -v java >/dev/null 2>&1; then
    osascript -e 'display dialog "Java is required. Install a JDK from https://adoptium.net, then open this app again." with title "APU Medical Centre HMS" buttons {"OK"} with icon stop'
    exit 1
fi

if command -v javac >/dev/null 2>&1; then
    mkdir -p bin
    find src -name '*.java' -print0 | xargs -0 javac -d bin -sourcepath src
fi

if [ ! -f bin/com/apu/hms/HospitalManagementSystem.class ]; then
    osascript -e 'display dialog "The application could not find compiled Java files. Install a JDK and open this app again." with title "APU Medical Centre HMS" buttons {"OK"} with icon stop'
    exit 1
fi

exec java -cp bin com.apu.hms.HospitalManagementSystem
